# Re-include CLAUDE.md, which the user's global ~/.gitignore_global excludes
# everywhere — this bootstrap repo needs to version-control it. (Sync hooks now
# live at the user level; see docs/vault-sync.md. This repo ships no `.claude/`
# directory.)
!CLAUDE.md

# Vault contents are populated at runtime by the SessionStart hook and must
# never be committed. Keep only the .gitkeep so the directory exists in git.
vault/*
!vault/.gitkeep

# obsidian-headless local state (only relevant if someone runs this locally)
.obsidian-headless/

# OS cruft
.DS_Store
