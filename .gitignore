# Re-include files excluded by the user's global gitignore. The global
# ~/.gitignore_global excludes `.claude` and `CLAUDE.md` everywhere, but
# those are exactly what this bootstrap repo exists to version-control.
!.claude
!.claude/**
!CLAUDE.md

# ...except the scheduler's runtime lock, which is regenerated every session
# and must never be committed.
.claude/scheduled_tasks.lock

# Vault contents are populated at runtime by the SessionStart hook and must
# never be committed. Keep only the .gitkeep so the directory exists in git.
vault/*
!vault/.gitkeep

# obsidian-headless local state (only relevant if someone runs this locally)
.obsidian-headless/

# OS cruft
.DS_Store
